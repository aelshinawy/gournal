{
  "name": "gournal",
  "version": "0.10.0",
  "homepage": "https://gournal.aelshinawy.com/",
  "bin": {
    "gournal": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build && npm test && npm run test:site",
    "dev": "ts-node src/cli.ts",
    "test": "jest",
    "test:ci": "jest --coverage",
    "test:site": "jest --config jest.site.config.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip --no-progress",
    "check:dashes": "node scripts/check-dashes.mjs",
    "docs:gen": "node -r ts-node/register/transpile-only site/scripts/reference/run.ts"
  },
  "keywords": [
    "journal",
    "cli",
    "nodejs",
    "typescript",
    "standup",
    "tasklog",
    "export",
    "productivity",
    "developer-tools",
    "git"
  ],
  "author": "Ahmed El-Shinawy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aelshinawy/gournal"
  },
  "bugs": {
    "url": "https://github.com/aelshinawy/gournal/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "A local-first work journal for you and your AI agents: log work from the CLI or MCP, link GitHub activity, and generate standups and work logs.",
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "commander": "^13.1.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@swc/jest": "^0.2.37",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.12.0",
    "dependency-cruiser": "18.8.0",
    "jest": "^29.7.0",
    "knip": "6.46.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
