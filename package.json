{
  "name": "gournal",
  "version": "0.9.0",
  "homepage": "https://aelshinawy.github.io/gournal/",
  "bin": {
    "gournal": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "dev": "ts-node src/cli.ts",
    "test": "jest",
    "test:ci": "jest --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "depcruise src --config .dependency-cruiser.cjs",
    "check:dashes": "node scripts/check-dashes.mjs",
    "docs:gen": "node -r ts-node/register/transpile-only site/scripts/reference/run.ts"
  },
  "keywords": [
    "journal",
    "cli",
    "nodejs",
    "typescript",
    "standup",
    "tasklog",
    "export",
    "productivity",
    "developer-tools",
    "git"
  ],
  "author": "Ahmed El-Shinawy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aelshinawy/gournal"
  },
  "bugs": {
    "url": "https://github.com/aelshinawy/gournal/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "A developer's command-line journal with Git integration: log work, generate standup reports, and export your history to Markdown or CSV.",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "chalk": "^4.1.2",
    "commander": "^13.1.0",
    "date-fns": "^4.1.0",
    "inquirer": "^12.3.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@swc/jest": "^0.2.37",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.12.0",
    "dependency-cruiser": "18.7.0",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
