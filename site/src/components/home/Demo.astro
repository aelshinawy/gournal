---
const base = import.meta.env.BASE_URL;
const poster = `${base}demo/standup-poster.png`;
// Proof marks beside the plate. Each top value is the line's place in the last frame of the recording.
const marks = [
  { top: 12.5, text: 'Done, grouped by project' },
  { top: 23.8, text: 'A PR and its commits, from GitHub' },
  { top: 53.7, text: 'Open items carry forward' },
  { top: 76.2, text: 'Activity that no entry claimed' }
];
---

<figure class="g-demo" aria-labelledby="g-demo-caption">
  <div class="g-demo__stage">
    <div class="g-demo__plate">
      <video
        class="g-demo__video"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        poster={poster}
        width="920"
        height="1000"
        aria-describedby="g-demo-caption"
        data-demo-video
      >
        <source src={`${base}demo/standup.webm`} type="video/webm" />
        <source src={`${base}demo/standup.mp4`} type="video/mp4" />
      </video>
      <img class="g-demo__still" src={poster} width="920" height="1000" alt="" loading="lazy" />
    </div>
    <ol class="g-demo__marks" aria-hidden="true">
      {marks.map((m) => <li style={`--y: ${m.top}%`}>{m.text}</li>)}
    </ol>
  </div>
  <figcaption id="g-demo-caption" class="g-demo__caption">
    <code>gournal standup</code> on sample data. Two projects, a merged pull request folded under the entry it
    belongs to, and an Also line for the rest. <a href="#transcript">Read the standup as text</a>.
  </figcaption>
</figure>

<script>
  // Reduced motion: stop the loop and show the poster frame. CSS also swaps in the still image.
  const video = document.querySelector<HTMLVideoElement>('[data-demo-video]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  function apply(): void {
    if (!video) return;
    if (reduce.matches) {
      video.removeAttribute('autoplay');
      video.pause();
    } else if (video.paused) {
      void video.play().catch(() => undefined);
    }
  }
  apply();
  reduce.addEventListener('change', apply);
</script>
