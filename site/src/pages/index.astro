---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/home.css';
import Nav from '../components/home/Nav.astro';
import Install from '../components/home/Install.astro';
import Demo from '../components/home/Demo.astro';
import Features from '../components/home/Features.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import LocalFirst from '../components/home/LocalFirst.astro';
import Footer from '../components/home/Footer.astro';
import { OG_ALT, OG_HEIGHT, OG_WIDTH, siteUrl } from '../../site.config.mjs';
import newsreaderUrl from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';

const title = 'gournal: a work journal for you and your AI agents';
const description =
  'Gournal is a local-first work journal for you and your AI agents. It keeps every entry in SQLite on your machine, needs no account, and stores no tokens.';
const canonical = siteUrl();
const ogImage = siteUrl('og.png');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="gournal" />
    <meta property="og:locale" content="en" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={OG_WIDTH} />
    <meta property="og:image:height" content={OG_HEIGHT} />
    <meta property="og:image:alt" content={OG_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={newsreaderUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f7f6fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1f2029" media="(prefers-color-scheme: dark)" />
    {/* Same rule as the Starlight theme script, so the docs choice carries over before paint. */}
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('starlight-theme');
        } catch {
          /* storage can be blocked */
        }
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="g-skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <section class="g-hero" aria-labelledby="g-hero-title">
        <div class="g-wrap">
          <h1 id="g-hero-title" class="g-hero__title">Your work, remembered.</h1>
          <div class="g-hero__intro">
            <p class="g-hero__lede">
              A personal work journal for you and your AI agents. Log what you finish from the terminal, or let your
              agent log it through MCP. Gournal links each entry to your GitHub activity and turns the journal into
              standups, work logs, and a history you can search.
            </p>
            <Install />
            <p class="g-hero__req">Needs Node 22.13 or newer. The <code>gh</code> CLI is optional.</p>
            <div class="g-actions">
              <a class="g-btn g-btn--primary" href="/docs/start-here/quickstart/">Get started</a>
              <a class="g-btn g-btn--secondary" href="#how-it-works">See how it works</a>
            </div>
            <ul class="g-hero__trust" aria-label="At a glance">
              <li>Local-first</li>
              <li>SQLite file</li>
              <li>No account</li>
              <li>No tokens stored</li>
            </ul>
          </div>
          <div class="g-hero__demo">
            <Demo />
          </div>
        </div>
      </section>
      <Features />
      <HowItWorks />
      <LocalFirst />
    </main>
    <Footer />
  </body>
</html>
